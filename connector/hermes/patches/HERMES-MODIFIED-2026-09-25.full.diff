diff --git a/hermes_cli/doctor_state.py b/hermes_cli/doctor_state.py
index 8851ee4b7c..d4491f0ff4 100644
--- a/hermes_cli/doctor_state.py
+++ b/hermes_cli/doctor_state.py
@@ -105,8 +105,18 @@ def _render_state_db_stats(stats: dict, holders=None) -> list:
 
 
 def _memory_store_flags(hermes_home: Path) -> tuple:
-    from tools.memory_tool import get_builtin_memory_store_flags
-    return get_builtin_memory_store_flags({"memory": _doctor_memory_config(hermes_home)})
+    # Local defensive patch: get_builtin_memory_store_flags is not exported by
+    # tools.memory_tool in 0.21.1 (upstream regression introduced after the
+    # 20-commit sync). Read the relevant config keys directly so doctor can
+    # still decide whether to inspect the memories/ directory.
+    try:
+        from tools.memory_tool import get_builtin_memory_store_flags
+        return get_builtin_memory_store_flags({"memory": _doctor_memory_config(hermes_home)})
+    except ImportError:
+        cfg = _doctor_memory_config(hermes_home) or {}
+        mem = cfg.get("memory_enabled", False)
+        user = cfg.get("user_profile_enabled", False)
+        return (bool(mem), bool(user))
 
 
 @doctor_check()
